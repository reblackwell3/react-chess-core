  "description": "Shared React chessboard theme, highlights, browser Stockfish, and analysis board",
  "license": "MIT",
  "author": "Robert Blackwell",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
