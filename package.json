    "@vitejs/plugin-react": "^4.3.1",
    "chess.js": "^1.0.0-beta.8",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-chessboard": "^4.7.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.2.9",
