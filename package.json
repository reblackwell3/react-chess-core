    "chess.js": "^1.0.0-beta.8",
    "react": "^18.3.1",
    "react-chessboard": "^4.7.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.9.0",
    "@rollup/plugin-commonjs": "^26.0.1",
